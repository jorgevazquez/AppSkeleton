{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "depends_on": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "default": {}
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*:[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "default": [],
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*:[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "default": [],
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "default": {
        "provides": [],
        "requires": []
      }
    },
    "entry_point": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\/)(?!.*\\.\\.(?:\\/|$))[A-Za-z0-9_./-]+\\.(?:ts|js|mjs|cjs)$"
    }
  },
  "required": [
    "id",
    "version",
    "entry_point"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://appskeleton.dev/schemas/plugin-manifest.schema.json",
  "title": "AppSkeleton plugin manifest (plugin.json)",
  "description": "Shape-level JSON Schema for a plugin's plugin.json, generated from the kernel's zod PluginManifestSchema (src/core/manifest.ts, feature #4) via zod-to-json-schema — see src/plugins/plugin-builder/src/manifest-json-schema.ts for how, and its documented limitation: depends_on values accept any non-empty string, since full semver-range validation has no static JSON Schema equivalent and is not re-implemented here. Treat this document as a shape-level contract; validateManifest() in the kernel remains authoritative."
}
