{
  "name": "appskeleton",
  "version": "0.1.0",
  "private": true,
  "description": "A plugin-based, security-first web application platform.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/plugins/database-mysql/src/migrate.ts up",
    "migrate:down": "tsx src/plugins/database-mysql/src/migrate.ts down",
    "seed": "tsx src/cli/seed.ts",
    "backup": "scripts/backup.sh",
    "restore": "scripts/restore.sh",
    "create-plugin": "tsx src/plugins/plugin-builder/src/cli.ts create",
    "introspect": "tsx src/cli/introspect.ts",
    "generate:manifest-schema": "tsx src/plugins/plugin-builder/src/generate-manifest-json-schema.ts",
    "generate:capability-index": "tsx src/plugins/plugin-builder/src/generate-capability-index.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "kysely": "^0.29.5",
    "mysql2": "^3.11.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "semver": "^7.8.5",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
